# Plantilla sin secretos. El archivo real vive solo en sia-app:
# /etc/sia/sia.env (root:sia, modo 640). No se copia al repositorio.
# DJANGO_SECRET_KEY se genera en el servidor.
# DJANGO_DB_PASSWORD se escribe ahí cuando PostgreSQL la pide, y no queda en git.
#
# El navegador entra directo a sia-nginx, que está en modo puente en el Wi-Fi.

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,30.30.30.1,30.30.30.2,192.168.200.119,sia.192.168.200.119.nip.io
DJANGO_CSRF_TRUSTED_ORIGINS=https://127.0.0.1,https://localhost,https://192.168.200.119,https://sia.192.168.200.119.nip.io
DJANGO_BEHIND_PROXY=True
DJANGO_USE_HTTPS=True

DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=sia
DJANGO_DB_USER=sia
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
